# =======================================================
# Golden Zone — Server Environment Configuration
# =======================================================

# Port on which the Express server listens
PORT=5000

# Node environment: development | production
NODE_ENV=development

# MySQL Database Connection Settings
# Host of the MySQL instance (e.g. localhost or 127.0.0.1)
DB_HOST=localhost

# Port of the MySQL instance (default: 3306)
DB_PORT=3306

# MySQL user with permissions to create and manage the kalyani_jewellers database
DB_USER=root

# MySQL password for the specified user
DB_PASSWORD=

# Database name
DB_NAME=kalyani_jewellers

# JWT Secret Key used for signing Customer and Admin access tokens
JWT_SECRET=kalyani_jewellers_secure_jwt_secret_2026_super_key

# JWT Token Expiry (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Initial Admin Mobile Number
ADMIN_MOBILE=7976580806

# Initial Admin Default Password (for reference; stored as bcrypt hash in DB)
ADMIN_INITIAL_PASSWORD=Subhash29

# Frontend Storefront Client URL for CORS
CLIENT_URL=http://localhost:5173

# Admin Panel URL for CORS
ADMIN_URL=http://localhost:5174

# Google Maps Base Direction / View URL
GOOGLE_MAPS_BASE_URL=https://www.google.com/maps

# =======================================================
# Razorpay Payment Gateway Configuration
# Obtain your API Keys from: https://dashboard.razorpay.com/app/keys
# Obtain Webhook Secret from: https://dashboard.razorpay.com/app/webhooks
# =======================================================

# Your Razorpay Key ID (Starts with rzp_test_... or rzp_live_...)
# Enter your real Razorpay Key ID here:
RAZORPAY_KEY_ID=

# Your Razorpay Key Secret (Keep this confidential; never expose to frontend)
# Enter your real Razorpay Key Secret here:
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret configured in your Razorpay Dashboard webhook settings
# (Used to verify incoming webhooks from Razorpay at /api/payments/webhook)
# Enter your real Razorpay Webhook Secret here:
RAZORPAY_WEBHOOK_SECRET=

# =======================================================
# Renflair SMS API Gateway Configuration
# =======================================================
RENFLAIR_API_KEY=
# Put the real Renflair API key here

RENFLAIR_API_URL=https://sms.renflair.in/V1.php
# SMS API endpoint

APP_DOMAIN=goldenzone.in
APP_NAME=Golden Zone


